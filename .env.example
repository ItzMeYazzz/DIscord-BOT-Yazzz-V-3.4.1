# ===== Wajib =====
DISCORD_TOKEN=TOKEN_BOT_DISCORD
CLIENT_ID=ID_CLIENT_BOT_DISCORD

# ===== Opsional =====
# ID server kamu: slash command langsung muncul (tanpa tunggu global)
GUILD_ID=
# ID Discord owner bot, pisahkan dengan koma
OWNER_IDS=

# ===== Status bot =====
STATUS_TEXT=PRIME BOT MADE BY : by.yasstzy_
VR_ICON=true

# ===== Prefix command =====
# Prefix teks: "yz play lofi", "yz skip", "yz mini wordle". Slash command tetap bisa dipakai.
# Butuh "Message Content Intent" aktif di Discord Developer Portal (Bot > Privileged Gateway Intents).
PREFIX=yz
# false = matikan prefix command (kalau mati, Message Content Intent tidak perlu)
PREFIX_ENABLED=true

# ===== Musik (NodeLink) =====
# Musik diputar oleh NodeLink (server audio terpisah, kompatibel Lavalink). Lihat NODELINK-SETUP.md.
# Samakan dengan server.host / server.port / server.password di config.ts milik NodeLink.
NODELINK_HOST=localhost
NODELINK_PORT=3000
NODELINK_PASSWORD=kampungk-4827
# true kalau NodeLink diakses lewat https/wss (mis. di belakang reverse proxy)
NODELINK_SECURE=false
NODELINK_NAME=NodeLink
# true = session resume Lavalink (hanya kalau NodeLink-mu mendukung)
NODELINK_RESUME=false
# Prefiks pencarian (bawaan ytsearch / scsearch). Mis. ytmsearch = YouTube Music
MUSIC_SEARCH_YOUTUBE=ytsearch
MUSIC_SEARCH_SOUNDCLOUD=scsearch

# ===== Opsional game =====
# MONO_NO_IMAGE=1   matikan gambar papan Monopoly
# LUDO_NO_IMAGE=1   matikan gambar papan Ludo
